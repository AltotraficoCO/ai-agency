# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca lo expongas en el cliente ni lo prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Modelos ─────────────────────────────────────────────────────────────────
# Cartera única: una factura, un saldo, respaldo automático entre proveedores.
AI_GATEWAY_API_KEY=

# ─── Cifrado ─────────────────────────────────────────────────────────────────
# 32 bytes en base64 para AES-256-GCM. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, las credenciales guardadas de terceros son irrecuperables.
ENCRYPTION_KEY=

# ─── Meta / WhatsApp (opcional hasta la fase del canal) ──────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Identificador de la configuración de Embedded Signup v4.
META_CONFIG_ID=

# ─── Stripe (opcional hasta la fase de créditos) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Entorno ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
