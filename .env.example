# PLANTILLA. No pongas valores reales aqui: este archivo SI se versiona y el
# repositorio es publico. Copialo a .env.local, que esta ignorado por git:
#   cp .env.example .env.local
#
# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca lo expongas en el cliente ni lo prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ─── Base de datos ───────────────────────────────────────────────────────────
# Conexión directa a Postgres. La usan el motor y el simulador, que bajan al rol
# `strappy_worker` dentro de cada transacción (ver packages/db/src/client.ts).
# Con Supabase local: postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_URL=
# Rol al que se baja dentro de la transacción. Solo cámbialo si sabes por qué.
STRAPPY_DB_ROLE=strappy_worker
# Solo desarrollo: cuenta sembrada que usa `obtenerUsuarioActual()` mientras no
# haya Supabase configurado. En cuanto NEXT_PUBLIC_SUPABASE_URL existe, se ignora.
STRAPPY_USUARIO_DEV=demo@strappy.test

# ─── Modelos ─────────────────────────────────────────────────────────────────
# Cartera única: un saldo, una factura, respaldo automático entre modelos.
# El usuario NUNCA elige el modelo: solo elige Lite o Max, y el sistema escoge
# el más adecuado según la tarea (conversar, construir, extraer, resumir...).
MODEL_WALLET=openrouter
OPENROUTER_API_KEY=
# Alternativa si se prefiere la cartera de Vercel (MODEL_WALLET=vercel-gateway)
AI_GATEWAY_API_KEY=

# ─── Cifrado ─────────────────────────────────────────────────────────────────
# 32 bytes en base64 para AES-256-GCM. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, las credenciales guardadas de terceros son irrecuperables.
ENCRYPTION_KEY=
# Clave maestra de `public.connections`: con ella se cifran y descifran las
# credenciales de los servicios del cliente (WordPress, Alegra, Google Ads, Meta
# y TikTok). La usan la web al guardar y el worker al trabajar, así que tiene
# que ser LA MISMA en los dos. Cualquier secreto de 16 caracteres o más.
APP_ENCRYPTION_KEY=

# ─── Meta / WhatsApp (opcional hasta la fase del canal) ──────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Identificador de la configuración de Embedded Signup v4.
META_CONFIG_ID=

# ─── Plataformas de anuncios (agente de Marketing) ───────────────────────────
# Las de Meta son las de arriba: es la misma app, con ads_read y ads_management.
# Sin estas variables la plataforma sale en Ajustes → Canales como "todavía no
# está configurada en este servidor" en vez de dar un error al conectar.
#
# Google Ads: cliente OAuth de un proyecto de Google Cloud con la API de Google
# Ads habilitada, y el developer token de NUESTRA cuenta de gestor (es lo que
# Google aprueba; sin él la API responde 403 a todo).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# TikTok for Business: app aprobada con permisos de Ads Management.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ─── Stripe (opcional hasta la fase de créditos) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Entorno ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
