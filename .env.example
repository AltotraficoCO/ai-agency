# PLANTILLA. No pongas valores reales aqui: este archivo SI se versiona y el
# repositorio es publico. Copialo a .env.local, que esta ignorado por git:
#   cp .env.example .env.local
#
# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca lo expongas en el cliente ni lo prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ─── Modelos ─────────────────────────────────────────────────────────────────
# Cartera única: un saldo, una factura, respaldo automático entre modelos.
# El usuario NUNCA elige el modelo: solo elige Lite o Max, y el sistema escoge
# el más adecuado según la tarea (conversar, construir, extraer, resumir...).
MODEL_WALLET=openrouter
OPENROUTER_API_KEY=
# Alternativa si se prefiere la cartera de Vercel (MODEL_WALLET=vercel-gateway)
AI_GATEWAY_API_KEY=

# ─── Cifrado ─────────────────────────────────────────────────────────────────
# 32 bytes en base64 para AES-256-GCM. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, las credenciales guardadas de terceros son irrecuperables.
ENCRYPTION_KEY=

# ─── Meta / WhatsApp (opcional hasta la fase del canal) ──────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Identificador de la configuración de Embedded Signup v4.
META_CONFIG_ID=

# ─── Stripe (opcional hasta la fase de créditos) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Entorno ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
