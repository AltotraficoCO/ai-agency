{
  "name": "@strappy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./spec": "./src/adapters/spec.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:apply": "./scripts/apply.sh",
    "db:test": "./scripts/test-isolation.sh",
    "db:validate": "./scripts/validate-local.sh",
    "test": "vitest run",
    "db:seed": "node ./scripts/seed-dev.mjs"
  },
  "files": [
    "src",
    "migrations",
    "tests",
    "scripts"
  ],
  "dependencies": {
    "@strappy/core": "workspace:*",
    "@strappy/tools": "workspace:*",
    "@strappy/rag": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.5"
  }
}
